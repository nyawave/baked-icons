{
  "name": "@nyawave/baked-icons",
  "version": "0.1.0",
  "description": "Iconify-compatible React <Icon> whose icons are baked into your bundle at build time. Zero runtime fetching, SSR/RSC friendly. Vite + Next.js (Turbopack/webpack).",
  "license": "MIT",
  "author": "IXackerr (https://github.com/IXackerr)",
  "homepage": "https://github.com/nyawave/baked-icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyawave/baked-icons.git",
    "directory": "packages/baked-icons"
  },
  "bugs": {
    "url": "https://github.com/nyawave/baked-icons/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./transform": {
      "types": "./dist/transform.d.mts",
      "import": "./dist/transform.mjs",
      "require": "./dist/transform.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.cjs"
    },
    "./loader": {
      "types": "./dist/loader.d.cts",
      "default": "./dist/loader.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src test",
    "prepublishOnly": "npm run build && npm run test"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "magic-string": "^1.4.1",
    "oxc-parser": "^0.150.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.132",
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.83.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "iconify",
    "icons",
    "icon",
    "react",
    "svg",
    "vite",
    "vite-plugin",
    "nextjs",
    "turbopack",
    "webpack",
    "rsc",
    "ssr",
    "build-time"
  ]
}
