{
  "name": "baked-icons-monorepo",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @nyawave/baked-icons build",
    "dev": "pnpm --filter @nyawave/baked-icons dev",
    "test": "pnpm --filter @nyawave/baked-icons test",
    "lint": "pnpm --filter @nyawave/baked-icons lint",
    "typecheck": "pnpm -r --filter '!site' typecheck",
    "build:examples": "pnpm --filter './examples/*' build",
    "dev:site": "pnpm --filter site dev",
    "build:site": "pnpm --filter site build",
    "ci": "pnpm build && pnpm test && pnpm typecheck && pnpm build:examples"
  }
}
